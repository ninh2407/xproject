{
  "name": "xproject",
  "private": true,
  "packageManager": "pnpm@10.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . && prettier --check \"{client,game-server,shared,tools}/**/*.{ts,tsx,json,yaml,yml}\"",
    "contracts:gen": "node tools/contracts/generate.mjs",
    "contracts:check": "node tools/contracts/check.mjs",
    "mock:api": "prism mock shared/contracts/public.yaml --host 0.0.0.0 --port 4010",
    "mock:api:internal": "prism mock shared/contracts/internal.yaml --host 0.0.0.0 --port 4011",
    "gamedata:gen": "node tools/gamedata/generate.mjs",
    "gamedata:build": "node tools/gamedata/check.mjs",
    "gamedata:check": "node tools/gamedata/check.mjs",
    "license:check": "node tools/licenses/check.mjs"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.42.0",
    "@stoplight/prism-cli": "5.16.0",
    "ajv": "8.17.1",
    "@types/node": "22.14.1",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.1.1"
  }
}
